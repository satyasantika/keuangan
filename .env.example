APP_NAME="Keuangan FKIP Unsil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal: http://localhost:8035/keuangan (nginx lokal memotong awalan, meniru reverse proxy).
# Produksi: https://supportfkip.unsil.ac.id/keuangan
APP_URL=http://localhost:8035/keuangan
ASSET_URL=${APP_URL}
APP_VERSION=1.0.0

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB native di host (bukan container). Isi DB_PASSWORD di .env lokal.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_keuangan
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/keuangan
SESSION_COOKIE=keuangan_session
# Produksi: true (cookie hanya lewat HTTPS; bawaan true bila APP_ENV=production)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Produksi: IP reverse proxy; lokal: *
TRUSTED_PROXIES=*
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Kebijakan berkas: tautan, bukan unggahan
BERKAS_MODE=tautan
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=keuangan_cache_

# Redis bersama (container "redis", jaringan code_laranet; hanya DB 0-15)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=keuangan_
REDIS_DB=13
REDIS_CACHE_DB=14
REDIS_QUEUE_DB=15
HORIZON_PREFIX=keuangan_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=keuangan-fkip@unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun super-admin pertama (php artisan db:seed). Isi SEED_ADMIN_PASSWORD secara manual di .env sebelum db:seed; jangan simpan di repo.
SEED_ADMIN_EMAIL=fkip@unsil.ac.id
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAMA="Admin TI Fakultas"

# MFA (autentikator) wajib bagi peran keuangan? Bawaan mati; MFA tetap bisa diaktifkan sukarela dari profil.
MFA_WAJIB=false

# Kanal WhatsApp opsional (gateway HTTP, mis. Fonnte). Biarkan false bila tidak dipakai.
WHATSAPP_AKTIF=false
WHATSAPP_URL=
WHATSAPP_TOKEN=
WHATSAPP_BATAS_PER_MENIT=20

# Data UAT (php artisan db:seed --class=UatSeeder --force; hanya APP_ENV=staging)
# UAT_EMAILS: akun=surel, dipisah koma (akun: admin-keuangan, wadek, bpp, pimpinan, kepala-pmat, admin-pmat, ...)
UAT_PASSWORD=
UAT_EMAILS=

# Akun demo panduan (PanduanSeeder, hanya local)
PANDUAN_PASSWORD=
