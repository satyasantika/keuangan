# Contoh .env.production untuk docker-compose.prod.yml. Salin ke .env.production (TIDAK di-commit) lalu isi rahasia.
APP_NAME="Keuangan FKIP Unsil"
# nama pendek aplikasi: awalan kunci cache bersama (detak penjadwal)
APP_KODE=keuangan
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://supportfkip.unsil.ac.id/keuangan
ASSET_URL=https://supportfkip.unsil.ac.id/keuangan
APP_VERSION=1.0.0

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MariaDB 10.11+ NATIVE di host (bukan container): container menjangkaunya lewat host-gateway.
DB_CONNECTION=mariadb
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_keuangan
DB_USERNAME=keuangan
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/keuangan
SESSION_COOKIE=keuangan_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
# IP reverse proxy depan (pisahkan dengan koma). Jangan "*" di produksi.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BERKAS_MODE=tautan
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=keuangan_cache_
KEUANGAN_LOCK_STORE=database

# Profil Ringan (STANDAR-TEKNIS §1b): sesi, cache, antrean, dan lock di database; tanpa Redis.

# SMTP kampus (G-08)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=keuangan-fkip@unsil.ac.id
MAIL_FROM_NAME="${APP_NAME}"

SEED_ADMIN_EMAIL=fkip@unsil.ac.id
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAMA="Admin TI Fakultas"
# Kata sandi awal bersifat sementara: ganti segera setelah masuk (menu pengguna > Profil).
# Aktifkan MFA wajib bagi peran keuangan dengan MFA_WAJIB=true bila sudah siap.
MFA_WAJIB=false

WHATSAPP_AKTIF=false
WHATSAPP_URL=
WHATSAPP_TOKEN=
WHATSAPP_BATAS_PER_MENIT=20

# Port host untuk container web (reverse proxy depan meneruskan /keuangan/ ke sini)
WEB_PORT=8035
