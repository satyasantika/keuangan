includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - config/
        - database/
        - routes/
    tmpDir: build/phpstan
    ignoreErrors:
        # Trait fondasi yang baru dipakai model transaksi mulai F6 (pencairan).
        -
            identifier: trait.unused
            paths:
                - app/Concerns/MenjagaPeriodeTerkunci.php
                - app/Concerns/DibatasiUnit.php
