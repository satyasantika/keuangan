includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - config/
        - database/
        - routes/
    tmpDir: build/phpstan
    ignoreErrors:
        # Trait fondasi yang baru dipakai model pada fase berikutnya.
        -
            identifier: trait.unused
            path: app/Concerns/MemilikiRiwayatStatus.php
